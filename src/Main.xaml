<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="薪光 · 桌面工资时钟" Width="390" Height="640" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI" Foreground="#F0F4EF" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#9CADAA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#304440"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="10" CornerRadius="24" BorderBrush="#354A43" BorderThickness="1" Background="#122923">
  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25"/></Border.Effect>
  <Grid Margin="23,18,23,20">
   <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid x:Name="DragArea" Background="Transparent" Cursor="SizeAll">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#D4E6B2" CornerRadius="8" Width="27" Height="27"><TextBlock Text="¥" Foreground="#1B3428" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="薪光" FontSize="17" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/><TextBlock Text="PAYDAY" Foreground="#6F8B80" FontSize="9" Margin="9,4,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Mask" Content="◎" Width="29" Height="29" ToolTip="隐藏 / 显示金额（Ctrl+H）" AutomationProperties.Name="隐藏或显示金额"/><Button x:Name="Pin" Content="◇" Width="29" Height="29" ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶"/><Button x:Name="Minimize" Content="−" Width="29" Height="29" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘"/><Button x:Name="Close" Content="×" Width="29" Height="29" ToolTip="退出薪光" AutomationProperties.Name="退出薪光"/></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1">
    <Grid Margin="0,20,0,0"><TextBlock x:Name="DateLabel" Foreground="#9BAD9F" FontSize="11" VerticalAlignment="Center"/><Border Background="#213F32" CornerRadius="10" Padding="9,5" HorizontalAlignment="Right"><TextBlock x:Name="Status" Text="●  正在积累" Foreground="#C5E5A3" FontSize="10"/></Border></Grid>
    <TextBlock x:Name="EarnedTitle" Text="今日已赚" Margin="0,25,0,2" Foreground="#B7C9BC" FontSize="14"/>
    <Grid Height="72"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CurrencyMark" Text="¥" Foreground="#ECD8AC" FontSize="12" VerticalAlignment="Center"/><Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock x:Name="Earned" Text="0.00" Foreground="#F1DFB4" FontFamily="Segoe UI" FontSize="57" FontWeight="Light"/></Viewbox></Grid>
    <TextBlock x:Name="Rate" Text="让每一秒的努力，都看得见。" Foreground="#8EA998" FontSize="11" Margin="0,5,0,0"/>
    <Grid Margin="0,8,0,0" Height="38"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions><TextBlock x:Name="FxInfo" FontSize="9" Foreground="#8EA998" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="FxRefresh" Grid.Column="1" Content="↻" ToolTip="检查最新参考汇率（数据日更）" AutomationProperties.Name="刷新汇率"/></Grid>
    <StackPanel x:Name="Details">
     <Border Background="#20382F" CornerRadius="16" Padding="16" Margin="0,22,0,0">
      <StackPanel><Grid><TextBlock Text="今日进度" Foreground="#A9BDAF" FontSize="11"/><TextBlock x:Name="ProgressLabel" HorizontalAlignment="Right" Foreground="#D4E6B2" FontSize="11"/></Grid><Grid Height="5" Margin="0,12,0,12"><Border CornerRadius="3" Background="#354C3D"/><Border x:Name="ProgressFill" CornerRadius="3" Background="#D4E6B2" HorizontalAlignment="Left" Width="0"/></Grid><Grid><TextBlock x:Name="ShiftLabel" Foreground="#7F9C89" FontSize="10"/><TextBlock x:Name="DayTarget" Foreground="#B8CCB7" HorizontalAlignment="Right" FontSize="10"/></Grid></StackPanel>
     </Border>
     <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本月累计" Foreground="#8EA998" FontSize="11"/><TextBlock x:Name="MonthEarned" FontFamily="Segoe UI" FontSize="18" Margin="0,7,0,0"/><TextBlock x:Name="Workdays" Foreground="#718F7C" FontSize="10" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#2C4436" Margin="0,0,0,2"/><StackPanel Grid.Column="2" Margin="22,0,0,0"><TextBlock x:Name="CountdownTitle" Text="距离下班" Foreground="#8EA998" FontSize="11"/><TextBlock x:Name="Countdown" FontFamily="Segoe UI" FontSize="23" Margin="0,7,0,0"/><TextBlock x:Name="CountdownNote" Foreground="#718F7C" FontSize="10" Margin="0,5,0,0"/></StackPanel></Grid>
     <Border BorderBrush="#2D4638" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0"><Grid><TextBlock x:Name="Hint" Text="把日子过好，收获正在路上。" Foreground="#9CB298" FontSize="11"/><TextBlock Text="✦" Foreground="#D9C48D" FontSize="17" HorizontalAlignment="Right"/></Grid></Border>
    </StackPanel>
   </StackPanel>
   <Grid Grid.Row="2" VerticalAlignment="Bottom"><Button x:Name="DiscreetToggle" Content="▱  低调模式" ToolTip="切换低调模式（Ctrl+Alt+D）" Padding="5,7" HorizontalAlignment="Center" FontSize="10"/><Button x:Name="Compact" Content="↗  迷你模式" Padding="5,7" HorizontalAlignment="Left" FontSize="10"/><Button x:Name="Settings" Content="⚙  薪资设置" Padding="9,7" HorizontalAlignment="Right" FontSize="11" Foreground="#CFDECB"/></Grid>
  </Grid>
 </Border>
</Window>
